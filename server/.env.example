# Server and frontend are served together on this port.
PORT=3000

# MySQL: set MYSQL_PASSWORD to your actual local MySQL root password.
# Leave blank only if your local root account has no password.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=algovis_db

# Optional: MongoDB local service or Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=algovis_db
